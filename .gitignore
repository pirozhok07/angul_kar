*.py[cod]
*$py.class

# Виртуальные окружения (ОЧЕНЬ ВАЖНО)
venv/
env/
.venv/
ENV/

# Данные о сборке и дистрибутивы
build/
dist/
*.egg-info/
.eggs/

# Базы данных SQLite (если используете локально)
*.sqlite3
*.db

# Секреты и переменные окружения (ОЧЕНЬ ВАЖНО)
.env
.env.*
!.env.example
*.pem

# Настройки тестирования и покрытия кода
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# 3. ANGULAR (Фронтенд)
# ==========================================
